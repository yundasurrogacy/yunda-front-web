{
  "name": "nuxt-shadcn-dashboard",
  "type": "module",
  "version": "0.2.6",
  "description": "Shadcn Dashboard built with Nuxt",
  "author": "Dian Pratama <dianpratama2@gmail.com>",
  "license": "MIT",
  "homepage": "https://dashboard.dianprata.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dianprata/nuxt-shadcn-dashboard.git"
  },
  "keywords": [
    "dashboard",
    "admin-dashboard",
    "vue",
    "nuxt",
    "shadcn-vue",
    "shadcn-nuxt",
    "shadcn-dashboard",
    "unocss"
  ],
  "main": "./nuxt.config.ts",
  "files": [
    "app.vue",
    "components",
    "components.json",
    "composables",
    "nuxt.config.ts",
    "pages",
    "types"
  ],
  "scripts": {
    "prebuild": "npm run sitemap:xml && npm run sitemap:html",
    "prebuild:dev": "npm run prebuild",
    "prebuild:prod": "npm run prebuild",
    "build": "nuxt build",
    "postbuild": "npm run seo:finalize-build",
    "build:dev": "cross-env NUXT_ENV=development nuxt build && npm run seo:finalize-build",
    "build:prod": "cross-env NUXT_ENV=production nuxt build && npm run seo:finalize-build",
    "dev": "nuxt dev",
    "pregenerate": "npm run sitemap:xml && npm run sitemap:html",
    "pregenerate:dev": "npm run pregenerate",
    "pregenerate:prod": "npm run pregenerate",
    "generate": "nuxt generate && npm run seo:finalize-build",
    "generate:dev": "cross-env NUXT_ENV=development nuxt generate && npm run seo:finalize-build",
    "generate:prod": "cross-env NUXT_ENV=production nuxt generate && npm run seo:finalize-build",
    "generate:obfuscated": "pnpm generate:prod && node scripts/obfuscate-code.cjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint --fix .",
    "sitemap:xml": "node scripts/generate-xml-sitemaps.cjs && node scripts/sync-vercel-zh-redirects.cjs",
    "sitemap:html": "node scripts/generate-html-sitemap.cjs",
    "seo:finalize-build": "node scripts/cleanup-200.cjs && node scripts/verify-p0-build.cjs && node scripts/verify-commercial-cannibalization.cjs && node scripts/verify-sitemap-quality.cjs && node scripts/verify-blog-pagination.cjs && node scripts/verify-priority-images.cjs",
    "seo:analyze-cannibalization": "node scripts/analyze-commercial-cannibalization.cjs",
    "seo:backup-commercial-blogs": "node scripts/backup-commercial-blogs.cjs",
    "seo:update-commercial-blogs": "node scripts/update-commercial-blogs.cjs",
    "verify:commercial-cannibalization": "node scripts/verify-commercial-cannibalization.cjs",
    "indexnow:submit": "node scripts/submit-indexnow.cjs",
    "verify:zh-seo": "node scripts/verify-zh-seo.cjs",
    "verify:sitemap-quality": "node scripts/verify-sitemap-quality.cjs",
    "verify:blog-pagination": "node scripts/verify-blog-pagination.cjs",
    "verify:priority-images": "node scripts/verify-priority-images.cjs"
  },
  "dependencies": {
    "@formatjs/intl-locale": "^4.2.11",
    "@iconify-json/lucide": "^1.2.30",
    "@iconify-json/radix-icons": "^1.2.2",
    "@internationalized/date": "^3.7.0",
    "@nuxtjs/proxy": "^2.1.0",
    "country-state-city": "^3.2.1",
    "vue-i18n": "^11.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.10.1",
    "@nuxt/eslint": "^1.2.0",
    "@nuxt/icon": "^1.15.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "^9.5.4",
    "@nuxtjs/sitemap": "^7.4.7",
    "@pinia/nuxt": "^0.5.1",
    "@unocss/eslint-plugin": "^66.0.0",
    "@unocss/nuxt": "^66.0.0",
    "@vee-validate/zod": "^4.15.0",
    "@vueuse/core": "^12.2.0",
    "@vueuse/math": "^12.2.0",
    "@vueuse/nuxt": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "eslint": "^9.22.0",
    "eslint-plugin-format": "^1.0.1",
    "glob": "^11.0.2",
    "javascript-obfuscator": "^4.1.1",
    "nuxt": "^3.16.2",
    "rollup-plugin-obfuscator": "^1.1.0",
    "shadcn-nuxt": "^0.10.4",
    "typescript": "^5.8.2",
    "unocss": "^66.0.0",
    "unocss-preset-animations": "^1.1.1",
    "unocss-preset-shadcn": "^0.5.0",
    "vee-validate": "^4.15.0",
    "vue": "3",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.1.10"
  }
}
