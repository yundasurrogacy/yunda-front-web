# 本地调试时让网站端(3000) 的 /api 代理到本地后台(3002)
# 启动后台: cd yunda-admin-system && pnpm dev  (端口 3002)
# 启动网站: cd yunda-front-web && API_PROXY_TARGET=http://localhost:3002 pnpm dev  (端口 3000)
API_PROXY_TARGET=http://localhost:3002

# 临时隐藏中文入口并将 /zh 重定向到英文（默认开启）；恢复语言切换时设为 false
# NUXT_PUBLIC_HIDE_LANGUAGE_SWITCHER=false
